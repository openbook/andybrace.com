{
  "name": "homesite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:a11y": "playwright test",
    "test:live": "BASE_URL=https://andybrace.com playwright test",
    "test:lighthouse": "npm run build && lhci autorun",
    "verify": "npm run format:check && npm run check && npm run lint && npm run test:a11y && npm run test:lighthouse"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@stylexjs/stylex": "^0.19.1",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
