---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import HowICanHelp from '../components/HowICanHelp';
import WhatIBring from '../components/WhatIBring';
import WorkingWithAI from '../components/WorkingWithAI';
import BestWork from '../components/BestWork';
import Contact from '../components/Contact';
import Footer from '../components/Footer';

const oneLiner =
  "I'm a developer who helps research and design-led teams take an idea through to something live that works for everyone.";
---

<Layout title="Andy Brace" description={oneLiner}>
  <main>
    <Hero name="Andy Brace" oneLiner={oneLiner} />
    <HowICanHelp />
    <WhatIBring />
    <WorkingWithAI />
    <BestWork />
    <Contact />
  </main>
  <Footer />
</Layout>
