---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import Footer from '../components/Footer';

const oneLiner =
  "I'm a developer who helps research and design-led teams take an idea or prototype through to something live that works for everyone, working out who it's for and what's worth building along the way.";

const privacyNote =
  'This site sets no cookies. Cloudflare hosts it and logs each request, including the IP address. I see only aggregate traffic figures.';
---

<Layout title="Andy Brace" description={oneLiner}>
  <main>
    <Hero name="Andy Brace" oneLiner={oneLiner} />
  </main>
  <Footer privacyNote={privacyNote} />
</Layout>
